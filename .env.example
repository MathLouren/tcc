# Copie para .env e preencha as credenciais antes de abrir /admin.
OLLAMA_URL=http://localhost:11434
LLM_MODELO=llama3.1:8b
VECTOR_STORE=local

ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional: mantém a autenticação por X-Admin-Key para scripts antigos.
