# ============================================================
# Chatbot Institucional UNIVERSO – configuração
# Copie este arquivo para .env (os scripts iniciar.* fazem isso).
# ============================================================

# Endereço do Ollama. É o único item que precisa ser ajustado.
#   Ollama no mesmo computador:  http://localhost:11434
#   Ollama em outra máquina:     http://IP_DA_MAQUINA:11434
#   Chatbot rodando no Docker:   http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434

# Modelo de linguagem já baixado no Ollama (ollama pull llama3.1:8b).
# Alternativas com bom português: qwen2.5:7b, gemma3:4b, llama3.2:3b (máquinas mais fracas).
LLM_MODELO=llama3.1:8b

# Chave das rotas administrativas (/admin/...). Troque por uma senha forte.
ADMIN_KEY=troque-esta-chave

# ------------------------------------------------------------
# Opcionais (os valores abaixo são os padrões)
# ------------------------------------------------------------
# Janela de contexto do modelo no Ollama, em tokens.
# LLM_NUM_CTX=8192
# Tempo máximo de espera por resposta do modelo, em segundos.
# LLM_TIMEOUT=120

# Embeddings: "sentence-transformers" (padrão do TCC, roda no próprio computador)
# ou "ollama" (usa o Ollama também para embeddings; rode antes: ollama pull bge-m3).
# EMBEDDING_PROVEDOR=sentence-transformers
# EMBEDDING_MODELO=intfloat/multilingual-e5-base

# API compatível com OpenAI em vez da API nativa do Ollama.
# LLM_API=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=

# Tamanho dos blocos e sobreposição, em tokens.
# CHUNK_TOKENS=500
# CHUNK_SOBREPOSICAO=50
