# ============================================================
# Chatbot Institucional UNIVERSO – configuração
# Copie este arquivo para .env (os scripts iniciar.* fazem isso).
# ============================================================

# Endereço do Ollama. É o único item que precisa ser ajustado.
#   Ollama no mesmo computador:  http://localhost:11434
#   Ollama em outra máquina:     http://IP_DA_MAQUINA:11434
#   Chatbot rodando no Docker:   http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434

# Modelo de linguagem já baixado no Ollama (ollama pull qwen2.5:7b).
# qwen2.5:7b foi o mais preciso nos testes de validação (34/35, contra 24/35 do gemma3:4b).
# Máquinas mais fracas: gemma3:4b ou llama3.2:3b, com menos acerto.
LLM_MODELO=qwen2.5:7b

# Login do painel administrativo (http://localhost:8000/admin). Troque por valores seus.
EMAIL=admin@exemplo.com
PASS=troque-esta-senha

# Opcional: chave para chamar as rotas /admin/... por script (cabeçalho X-Admin-Key).
# ADMIN_KEY=

# ------------------------------------------------------------
# Opcionais (os valores abaixo são os padrões)
# ------------------------------------------------------------
# Janela de contexto do modelo no Ollama, em tokens.
# 4096 cabe numa placa de 6 GB com o qwen2.5:7b; o maior prompt medido tem cerca de 3.300 tokens.
LLM_NUM_CTX=4096
# Tempo máximo de espera por resposta do modelo, em segundos.
# LLM_TIMEOUT=120
# Mantém o modelo carregado após uma resposta para evitar novas inicializações lentas.
# O servidor também carrega o modelo ao iniciar, para a primeira pergunta não esperar.
# LLM_KEEP_ALIVE=2h
# Camadas do modelo na GPU. -1 deixa o Ollama decidir; 99 força o modelo inteiro na GPU,
# bem mais rápido quando cabe (qwen2.5:7b numa placa de 6 GB cabe). Se faltar memória
# de vídeo, o chatbot volta sozinho ao ajuste automático.
# LLM_NUM_GPU=-1
#
# Placas GTX 16xx (ex.: 1660 SUPER) no Windows: o CUDA do Ollama lê o prompt devagar.
# O backend Vulkan do próprio Ollama foi cerca de 3x mais rápido nos testes. Para ativar,
# defina as variáveis de ambiente do Windows OLLAMA_VULKAN=1 e CUDA_VISIBLE_DEVICES=-1
# e reinicie o Ollama.

# Limite de cada PDF enviado pela rota administrativa de upload.
# PDF_UPLOAD_MAX_MB=25

# Embeddings: "sentence-transformers" (padrão do TCC, roda no próprio computador)
# ou "ollama" (usa o Ollama também para embeddings; rode antes: ollama pull bge-m3).
# EMBEDDING_PROVEDOR=sentence-transformers
# EMBEDDING_MODELO=intfloat/multilingual-e5-base

# API compatível com OpenAI em vez da API nativa do Ollama.
# LLM_API=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# Só na API OpenAI: modelos tentados em ordem quando o principal falha ou não começa a responder
# em LLM_TIMEOUT_PRIMEIRO_TOKEN segundos (0 = desligado). A resposta chega em stream ao navegador.
# LLM_MODELOS_RESERVA=qwen/qwen3-235b-a22b-2507,meta-llama/llama-3.3-70b-instruct
# LLM_TIMEOUT_PRIMEIRO_TOKEN=0
# Teto de tokens de cada resposta (Ollama e API OpenAI).
# LLM_MAX_TOKENS=700

# Respostas das N perguntas mais frequentes dos registros geradas ao subir, após reindexar e a
# cada novo dia, para que fiquem no cache (0 = desligado). Cada uma é uma chamada ao modelo.
# CACHE_AQUECER=0

# Reordenação dos candidatos por um cross-encoder multilíngue (vazio = desligado). Melhora a ordem
# dos trechos e permite top_k=3; custa ~0,3 s de CPU por pergunta. Baixa ~470 MB na primeira subida.
# RERANKER_MODELO=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# RERANKER_CANDIDATOS=6

# Tamanho dos blocos e sobreposição, em tokens.
# CHUNK_TOKENS=500
# CHUNK_SOBREPOSICAO=50
